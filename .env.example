# ===== Cơ sở dữ liệu =====
# PostgreSQL. Tạo CSDL miễn phí trên https://neon.tech (hoặc Supabase) rồi dán chuỗi kết nối vào đây.
# Neon: Dashboard > Connect > copy "Connection string" (bỏ chọn "Connection pooling")
# Supabase: Project > Connect > "Session pooler"
# Postgres cài trên máy: postgresql://postgres:matkhau@localhost:5432/vietmart
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ===== Bảo mật phiên đăng nhập (JWT) =====
AUTH_SECRET="+AFUK2UObgpEQ3YNJXxBm57quDZiJBgna5ZULzSKWCOZ3kZayKDaqksTln/LZCNH"

# URL công khai của website (dùng làm Return URL / IPN URL cho cổng thanh toán khi deploy)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== Thanh toán =====
# PAYMENT_MODE=mock  -> dùng cổng thanh toán giả lập (không cần mạng/key, chữ ký vẫn được kiểm tra)
# Bỏ trống           -> VNPAY dùng sandbox nếu có key bên dưới (thiếu key sẽ tự chuyển giả lập)
PAYMENT_MODE=

# VNPAY sandbox: đăng ký miễn phí tại https://sandbox.vnpayment.vn/devreg/ (nhận TMN code + Hash secret qua email)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"


# ===== Trợ lý AI =====
# Chỉ cần điền 1 trong các key dưới đây (tự nhận diện theo thứ tự). Không có key nào -> chế độ offline (tra cứu cơ bản).
# Ép chọn nhà cung cấp: AI_PROVIDER=anthropic | gemini | groq | openrouter | ollama | custom | offline
AI_PROVIDER=

# 1) Google Gemini – MIỄN PHÍ, lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"


